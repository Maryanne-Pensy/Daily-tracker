PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/daily_sheet
# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Timezone that decides when "today" rolls over (IANA name)
APP_TIMEZONE=Africa/Nairobi
# Hour (0-23) when the Today page switches from "Slotly" to "Evening: digital products"
EVENING_HOUR=17
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
